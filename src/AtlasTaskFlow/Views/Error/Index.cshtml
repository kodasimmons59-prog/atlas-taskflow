@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    Layout = "_PlainLayout";
}
<div class="empty-state my-5">
    <h1 class="h4">Something went wrong on our side</h1>
    <p>The error has been logged. Please go back and try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-body-secondary">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" href="~/">Back to dashboard</a>
</div>
