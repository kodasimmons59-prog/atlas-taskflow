@model string
@{
    ViewData["Title"] = "Check your email";
}
<div class="auth-wrap">
    <h1>Check your email</h1>
    <section class="panel">
        <p>If <strong>@Model</strong> belongs to an Atlas account, we've sent it a link to reset the password. The link works once and expires in a day.</p>
        <a class="btn btn-outline-secondary" asp-action="SignIn">Back to sign in</a>
    </section>
</div>
