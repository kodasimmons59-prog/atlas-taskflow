@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}
<div class="auth-wrap">
    <h1>Reset your password</h1>
    <p class="text-body-secondary">Enter your account email and we'll send you a link to choose a new password.</p>
    <section class="panel">
        <form method="post" asp-action="ForgotPassword" novalidate>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button class="btn btn-primary w-100">Send reset link</button>
        </form>
        <p class="small mt-3 mb-0"><a asp-action="SignIn">Back to sign in</a></p>
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
