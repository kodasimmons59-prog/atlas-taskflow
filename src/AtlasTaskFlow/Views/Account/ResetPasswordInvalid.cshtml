@{
    ViewData["Title"] = "Link not valid";
}
<div class="auth-wrap">
    <h1>This reset link doesn't work</h1>
    <section class="panel">
        <p>It may have been used already, have expired, or been copied incompletely. You can ask for a new one.</p>
        <a class="btn btn-primary" asp-action="ForgotPassword">Send a new link</a>
    </section>
</div>
